# =============================================================
# LingoEQ — Environment Configuration
# Copy this file to .env and fill in your values.
# All variables have sensible defaults except LLM_API_KEY.
# =============================================================

# -------------------------------------------------------
# [Required] LLM Provider
# Works with any OpenAI-compatible API (SiliconFlow, OpenAI, Ollama, etc.)
# -------------------------------------------------------
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_NAME=deepseek-ai/DeepSeek-V3

# -------------------------------------------------------
# [Optional] LLM Behavior
# -------------------------------------------------------
# LLM_TEMPERATURE=0.3          # Lower = more deterministic (recommended for EQ tasks)
# MAX_REFLEXION_DEPTH=2        # Max closed-loop self-correction passes (0 to disable)

# -------------------------------------------------------
# [Optional] Network
# -------------------------------------------------------
# WS_HOST=127.0.0.1
# WS_PORT=8888                 # Must match the port set in your C++/JUCE plugin

# -------------------------------------------------------
# [Optional] RAG & Memory
# -------------------------------------------------------
# RAG_TOP_K=5                  # Number of knowledge snippets injected per request
# RAG_DISTANCE_THRESHOLD=1.125 # Stricter = fewer but more relevant results
# PRESET_DISTANCE_THRESHOLD=1.3
# MAX_CONVERSATION_HISTORY=5

# -------------------------------------------------------
# [Optional] Psychoacoustic Sensory
# -------------------------------------------------------
# MAX_SENSORY_SLOTS=5
# SENSORY_TOP_PEAKS=3
# SENSORY_TOP_VALLEYS=2

# -------------------------------------------------------
# [Optional] Physical Guardrails (Safety Clamping)
# Changing these beyond hardware limits may damage speakers.
# -------------------------------------------------------
# SAFETY_MARGIN=1.2
# GAIN_LIMIT_MIN=-24.0
# GAIN_LIMIT_MAX=18.0
# FREQ_LIMIT_MIN=20.0
# FREQ_LIMIT_MAX=20000.0
# Q_LIMIT_MIN=0.1
# Q_LIMIT_MAX=10.0
